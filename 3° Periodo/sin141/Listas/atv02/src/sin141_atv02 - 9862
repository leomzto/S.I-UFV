    void empinar() {
        System.out.println("Empinando a moto");
    }
}

class Caminhao extends Veiculo {
    double cargaMaxima;

    void carregarCarga() {
        System.out.println("Carregando carga");
    }
}

class Aviao extends Veiculo {
    int numeroMotores;

    void voar() {
        System.out.println("Avião está voando");
    }
}

class Barco extends Veiculo {
